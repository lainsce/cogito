cask tracker_mod

bring stdr
bring vimana
bring tracker_constants

:: byte_at(bytes = any, pos = num) (( num ))
    <- stdr.floor(stdr.num(bytes[pos] ?? 0)) % 256
;

:: byte_slice(bytes = any, off = num, length = num) (( [any] ))
    let ?out = []: [any]
    for (let ?i = 0; i < length; i += 1)
        stdr.push(out, byte_at(bytes, off + i))
    <- out
;

:: note_name(n = num) (( string ))
    if n == tracker_constants.NOTE_HOLD
        <- "---"
    if n == tracker_constants.NOTE_REST
        <- "OFF"
    let tone = n % 12
    let oct = stdr.floor(n / 12)
    let ?name = "C-"
    if tone == 1
        name = "C#"
    elif tone == 2
        name = "D-"
    elif tone == 3
        name = "D#"
    elif tone == 4
        name = "E-"
    elif tone == 5
        name = "F-"
    elif tone == 6
        name = "F#"
    elif tone == 7
        name = "G-"
    elif tone == 8
        name = "G#"
    elif tone == 9
        name = "A-"
    elif tone == 10
        name = "A#"
    elif tone == 11
        name = "B-"
    <- name + hex1(oct)
;

:: hex1(n = num) (( string ))
    let HEX = "0123456789ABCDEF"
    <- stdr.char_at(HEX, n % 16)
;

:: hex2(n = num) (( string ))
    let HEX = "0123456789ABCDEF"
    let b = n % 256
    <- stdr.char_at(HEX, stdr.floor(b / 16)) + stdr.char_at(HEX, b % 16)
;

:: hex3(n = num) (( string ))
    let b = n % 4096
    <- hex1(stdr.floor(b / 256)) + hex2(b % 256)
;

:: wave_code(w = num) (( num ))
    if w == vimana.wave_triangle
        <- 1
    elif w == vimana.wave_sawtooth
        <- 2
    elif w == vimana.wave_pulse
        <- 3
    elif w == vimana.wave_noise
        <- 4
    elif w == vimana.wave_psg
        <- 5
    <- 1
;

:: code_wave(c = num) (( num ))
    if c == 2
        <- vimana.wave_sawtooth
    elif c == 3
        <- vimana.wave_pulse
    elif c == 4
        <- vimana.wave_noise
    elif c == 5
        <- vimana.wave_psg
    <- vimana.wave_triangle
;

:: wave_type(w = num) (( string ))
    if w == vimana.wave_triangle
        <- "TRI"
    elif w == vimana.wave_sawtooth
        <- "SAW"
    elif w == vimana.wave_pulse
        <- "PUL"
    elif w == vimana.wave_noise
        <- "NOI"
    elif w == vimana.wave_psg
        <- "PSG"
    <- "PCM"
;

:: base_period(semi = num) (( num ))
    if semi == 1
        <- 808
    elif semi == 2
        <- 762
    elif semi == 3
        <- 720
    elif semi == 4
        <- 678
    elif semi == 5
        <- 640
    elif semi == 6
        <- 604
    elif semi == 7
        <- 570
    elif semi == 8
        <- 538
    elif semi == 9
        <- 508
    elif semi == 10
        <- 480
    elif semi == 11
        <- 453
    <- 856
;

:: period_for_note(n = num) (( num ))
    let semi = n % 12
    let ?oct = stdr.floor(n / 12)
    if oct < 1
        oct = 1
    if oct > 8
        oct = 8
    let ?p = base_period(semi) >> (oct - 1)
    if p < 28
        p = 28
    <- p
;

def ?nn_table = []: [num]
def ?nn_table_ready = false

: build_nn_table() (( -- ))
    for (let ?oct = 1; oct <= 8; oct += 1)
        for (let ?semi = 0; semi < 12; semi += 1)
            stdr.push(nn_table, period_for_note(oct * 12 + semi))
    nn_table_ready = true
;

:: nearest_note(period = num) (( num ))
    if !nn_table_ready
        build_nn_table()
    let ?best = 48
    let ?best_diff = 9999
    for (let ?i = 0; i < 96; i += 1)
        let ?d = nn_table[i] - period
        if d < 0
            d = 0 - d
        if d < best_diff
            best_diff = d
            best = 12 + i
    <- best
;
