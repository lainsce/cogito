-- Special note values
def NOTE_HOLD = -1
def NOTE_REST = -2

:: semitone_for_key(ch = string) (( num ))
    if ch == "z" || ch == "Z"
        <- 0
    if ch == "s" || ch == "S"
        <- 1
    if ch == "x" || ch == "X"
        <- 2
    if ch == "d" || ch == "D"
        <- 3
    if ch == "c" || ch == "C"
        <- 4
    if ch == "v" || ch == "V"
        <- 5
    if ch == "g" || ch == "G"
        <- 6
    if ch == "b" || ch == "B"
        <- 7
    if ch == "h" || ch == "H"
        <- 8
    if ch == "n" || ch == "N"
        <- 9
    if ch == "j" || ch == "J"
        <- 10
    if ch == "m" || ch == "M"
        <- 11
    <- -1
;

