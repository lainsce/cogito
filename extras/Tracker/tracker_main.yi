cask main

bring stdr
bring vimana
bring tracker_font
bring tracker_constants
bring tracker_state
bring tracker_editor
bring tracker_playback
bring tracker_io
bring tracker_samples
bring tracker_ui
bring tracker_demo

: handle_keys(sys = vimana.system, dev = vimana.device, fsys = vimana.file) (( -- ))
    let help_now = dev.key_down(tracker_constants.KEY_H)
    if help_now != tracker_state.show_help
        tracker_state.show_help = help_now
        tracker_state.dirty = true

    if tracker_state.editing_filename
        let txt = dev.text_input()
        if stdr.len(txt) > 0
            tracker_editor.edit_filename_text(txt)
        if dev.key_pressed(tracker_constants.KEY_BACKSPACE)
            tracker_editor.backspace_filename()
        if dev.key_pressed(tracker_constants.KEY_RETURN)
            tracker_editor.finish_filename_edit()
        if dev.key_pressed(tracker_constants.KEY_ESCAPE)
            tracker_state.editing_filename = false
            tracker_state.dirty = true
        <-

    if tracker_state.editing_sample_name
        let txt = dev.text_input()
        if stdr.len(txt) > 0
            tracker_samples.edit_sample_name_text(txt)
        if dev.key_pressed(tracker_constants.KEY_BACKSPACE)
            tracker_samples.backspace_sample_name()
        if dev.key_pressed(tracker_constants.KEY_RETURN)
            tracker_samples.finish_sample_name_edit()
        if dev.key_pressed(tracker_constants.KEY_ESCAPE)
            tracker_state.editing_sample_name = false
            tracker_state.dirty = true
        <-

    let cmd = dev.key_down(tracker_constants.KEY_LGUI) || dev.key_down(tracker_constants.KEY_RGUI)
    if cmd
        if dev.key_pressed(tracker_constants.KEY_O)
            tracker_io.open_file(fsys, sys)
            <-
        if dev.key_pressed(tracker_constants.KEY_S)
            let shift = dev.key_down(tracker_constants.KEY_LSHIFT) || dev.key_down(tracker_constants.KEY_RSHIFT)
            if shift
                tracker_io.save_file_as(fsys)
            else
                tracker_io.save_file(fsys)
            <-

    if dev.key_pressed(tracker_constants.KEY_ESCAPE)
        tracker_playback.stop_playback(sys)
    if dev.key_pressed(tracker_constants.KEY_SPACE)
        tracker_playback.toggle_playback(sys)
    if dev.key_pressed(tracker_constants.KEY_RETURN)
        tracker_playback.trigger_step(sys, tracker_state.cursor_step)
        tracker_state.dirty = true
    if dev.key_pressed(tracker_constants.KEY_BACKSPACE)
        tracker_editor.rest_at_cursor(sys)

    if dev.key_pressed(tracker_constants.KEY_RIGHT)
        tracker_state.cursor_track += 1
        tracker_state.dirty = true
    if dev.key_pressed(tracker_constants.KEY_LEFT)
        tracker_state.cursor_track -= 1
        tracker_state.dirty = true
    if dev.key_pressed(tracker_constants.KEY_DOWN)
        tracker_state.cursor_step += 1
        tracker_state.dirty = true
    if dev.key_pressed(tracker_constants.KEY_UP)
        tracker_state.cursor_step -= 1
        tracker_state.dirty = true
    tracker_editor.clamp_cursor()

    if dev.key_pressed(tracker_constants.KEY_LBRACKET) && tracker_state.octave > 1
        tracker_state.octave -= 1
        tracker_state.dirty = true
    if dev.key_pressed(tracker_constants.KEY_RBRACKET) && tracker_state.octave < 8
        tracker_state.octave += 1
        tracker_state.dirty = true
    if dev.key_pressed(tracker_constants.KEY_PAGEUP)
        tracker_editor.set_page(tracker_state.page - 1)
    if dev.key_pressed(tracker_constants.KEY_PAGEDOWN)
        tracker_editor.set_page(tracker_state.page + 1)
    if dev.key_pressed(tracker_constants.KEY_MINUS) && tracker_state.bpm > 40
        tracker_state.bpm -= 4
        tracker_state.dirty = true
    if dev.key_pressed(tracker_constants.KEY_EQUALS) && tracker_state.bpm < 280
        tracker_state.bpm += 4
        tracker_state.dirty = true
    if dev.key_pressed(tracker_constants.KEY_COMMA) && tracker_state.master > 0
        tracker_state.master -= 1
        tracker_state.dirty = true
    if dev.key_pressed(tracker_constants.KEY_PERIOD) && tracker_state.master < 15
        tracker_state.master += 1
        tracker_state.dirty = true
    if dev.key_pressed(tracker_constants.KEY_Q) && tracker_state.cutoff > 80
        tracker_state.cutoff -= 80
        tracker_state.dirty = true
    if dev.key_pressed(tracker_constants.KEY_W) && tracker_state.cutoff < 1960
        tracker_state.cutoff += 80
        tracker_state.dirty = true
    if dev.key_pressed(tracker_constants.KEY_E) && tracker_state.resonance > 0
        tracker_state.resonance -= 1
        tracker_state.dirty = true
    if dev.key_pressed(tracker_constants.KEY_R) && tracker_state.resonance < 15
        tracker_state.resonance += 1
        tracker_state.dirty = true
    if dev.key_pressed(tracker_constants.KEY_F)
        tracker_state.filter_mode += 1
        if tracker_state.filter_mode > 4
            tracker_state.filter_mode = 1
        tracker_state.dirty = true

    if dev.key_pressed(tracker_constants.KEY_1)
        tracker_state.waves[tracker_state.cursor_track] = vimana.wave_triangle
        tracker_state.dirty = true
    if dev.key_pressed(tracker_constants.KEY_2)
        tracker_state.waves[tracker_state.cursor_track] = vimana.wave_sawtooth
        tracker_state.dirty = true
    if dev.key_pressed(tracker_constants.KEY_3)
        tracker_state.waves[tracker_state.cursor_track] = vimana.wave_pulse
        tracker_state.dirty = true
    if dev.key_pressed(tracker_constants.KEY_4)
        tracker_state.waves[tracker_state.cursor_track] = vimana.wave_noise
        tracker_state.dirty = true
    if dev.key_pressed(tracker_constants.KEY_5)
        tracker_state.waves[tracker_state.cursor_track] = vimana.wave_psg
        tracker_state.dirty = true

    let txt = dev.text_input()
    if stdr.len(txt) > 0
        let semi = tracker_constants.semitone_for_key(stdr.char_at(txt, 0))
        if semi >= 0
            tracker_editor.set_note(sys, semi)
            tracker_state.cursor_step += 1
            tracker_editor.clamp_cursor()
            tracker_state.dirty = true
;

: handle_mouse(sys = vimana.system, dev = vimana.device, fsys = vimana.file) (( -- ))
    let new_button_down = dev.mouse_down(vimana.mouse_left)
    if new_button_down != tracker_state.button_down
        tracker_state.button_down = new_button_down
        tracker_state.dirty = true
    let new_transport_hover = tracker_ui.hovered_transport_btn(dev)
    if new_transport_hover != tracker_state.transport_btn_hover
        tracker_state.transport_btn_hover = new_transport_hover
        tracker_state.dirty = true
    let new_hover = tracker_ui.hovered_file_btn(dev)
    if new_hover != tracker_state.file_btn_hover
        tracker_state.file_btn_hover = new_hover
        tracker_state.dirty = true
    let new_view_hover = tracker_ui.hovered_view_btn(dev)
    if new_view_hover != tracker_state.view_btn_hover
        tracker_state.view_btn_hover = new_view_hover
        tracker_state.dirty = true
    let ?new_nav_hover = -1
    let ?new_load_hover = false
    let ?new_field_hover = -1
    let ?new_btn_hover = -1
    let ?new_action_hover = -1
    if tracker_state.view_mode == 1
        new_nav_hover = tracker_ui.hovered_sample_nav(dev)
        new_load_hover = tracker_ui.in_sample_load_btn(dev)
        new_field_hover = tracker_ui.hovered_sample_field(dev)
        new_btn_hover = tracker_ui.hovered_sample_field_btn(dev)
        new_action_hover = tracker_ui.hovered_sample_action(dev)
    if new_nav_hover != tracker_state.sample_nav_hover
        tracker_state.sample_nav_hover = new_nav_hover
        tracker_state.dirty = true
    if new_load_hover != tracker_state.sample_load_hover
        tracker_state.sample_load_hover = new_load_hover
        tracker_state.dirty = true
    if new_field_hover != tracker_state.sample_field_hover
        tracker_state.sample_field_hover = new_field_hover
        tracker_state.dirty = true
    if new_btn_hover != tracker_state.sample_btn_hover
        tracker_state.sample_btn_hover = new_btn_hover
        tracker_state.dirty = true
    if new_action_hover != tracker_state.sample_action_hover
        tracker_state.sample_action_hover = new_action_hover
        tracker_state.dirty = true
    let ?new_pattern_hover = -1
    if tracker_ui.in_pattern_map(dev)
        new_pattern_hover = tracker_ui.pattern_map_index_at(dev)
    if new_pattern_hover != tracker_state.pattern_hover_index
        tracker_state.pattern_hover_index = new_pattern_hover
        tracker_state.dirty = true

    let wy = dev.wheel_y()
    let pattern_wheel = wy != 0 && tracker_state.song_loaded && tracker_state.pattern_hover_index >= 0 && tracker_state.pattern_hover_index < tracker_state.song_length
    if pattern_wheel
        let ?delta = 1
        if wy < 0
            delta = -1
        tracker_editor.bump_pattern(tracker_state.pattern_hover_index, delta)
    if wy != 0 && tracker_state.view_mode == 1 && tracker_state.sample_field_hover >= 1
        let ?delta = 1
        if wy < 0
            delta = -1
        tracker_samples.adjust_sample_field(sys, tracker_state.sample_field_hover, delta)
    if wy != 0 && !pattern_wheel && tracker_state.view_mode == 0 && (tracker_ui.in_grid_area(dev) || tracker_ui.in_grid_scrollbar(dev))
        tracker_state.cursor_step -= wy
        tracker_editor.clamp_cursor()
        tracker_state.dirty = true

    if tracker_state.scrollbar_dragging
        if dev.mouse_down(vimana.mouse_left)
            tracker_state.cursor_step = tracker_ui.scrollbar_step_at(dev.pointer_y())
            tracker_editor.clamp_cursor()
            tracker_state.dirty = true
        else
            tracker_state.scrollbar_dragging = false

    if tracker_state.view_mode == 1 && tracker_state.sample_dragging
        tracker_samples.update_sample_drag(dev)
        if !dev.mouse_down(vimana.mouse_left)
            tracker_state.sample_dragging = false
            tracker_state.dirty = true

    if dev.mouse_pressed(vimana.mouse_right) && tracker_state.song_loaded && tracker_state.pattern_hover_index >= 0
        tracker_editor.shrink_song_at(tracker_state.pattern_hover_index)
        <-

    if !dev.mouse_pressed(vimana.mouse_left)
        <-
    let mx = dev.pointer_x()
    let my = dev.pointer_y()
    if tracker_state.editing_sample_name && (tracker_state.view_mode != 1 || tracker_state.sample_field_hover != 0)
        tracker_samples.finish_sample_name_edit()
    if mx >= tracker_constants.HEADER_FILE_X && mx < tracker_constants.HEADER_FILE_X + tracker_constants.HEADER_FILE_W && my >= tracker_constants.HEADER_FILE_Y && my < tracker_constants.HEADER_FILE_Y + tracker_constants.FONT_H
        tracker_state.editing_filename = true
        tracker_state.editing_sample_name = false
        tracker_state.dirty = true
        <-
    elif tracker_state.editing_filename
        tracker_editor.finish_filename_edit()
    if tracker_state.transport_btn_hover == 0
        tracker_playback.toggle_playback(sys)
        <-
    if tracker_state.transport_btn_hover == 1
        tracker_playback.stop_playback(sys)
        <-
    if tracker_state.file_btn_hover == 0
        tracker_editor.new_file(sys)
        <-
    if tracker_state.file_btn_hover == 1
        tracker_io.open_file(fsys, sys)
        <-
    if tracker_state.file_btn_hover == 2
        tracker_io.save_file(fsys)
        <-
    if tracker_state.view_btn_hover == 0
        tracker_state.view_mode = 0
        tracker_state.editing_sample_name = false
        tracker_state.dirty = true
        <-
    if tracker_state.view_btn_hover == 1
        tracker_state.view_mode = 1
        tracker_samples.clamp_sample_view()
        tracker_state.dirty = true
        <-
    if tracker_state.song_loaded && tracker_state.pattern_hover_index >= 0
        if tracker_state.pattern_hover_index < tracker_state.song_length
            tracker_state.selected_order = tracker_state.pattern_hover_index
        elif tracker_state.pattern_hover_index == tracker_state.song_length
            tracker_editor.extend_song_to(tracker_state.pattern_hover_index)
            tracker_state.selected_order = tracker_state.pattern_hover_index
        tracker_state.dirty = true
        <-
    if tracker_state.view_mode == 1
        if tracker_state.sample_nav_hover == 0
            tracker_state.sample_view_index -= 1
            tracker_samples.clamp_sample_view()
            tracker_samples.invalidate_sample_peaks()
            tracker_state.editing_sample_name = false
            tracker_state.dirty = true
            <-
        if tracker_state.sample_nav_hover == 1
            tracker_state.sample_view_index += 1
            tracker_samples.clamp_sample_view()
            tracker_samples.invalidate_sample_peaks()
            tracker_state.editing_sample_name = false
            tracker_state.dirty = true
            <-
        if tracker_state.sample_load_hover
            tracker_io.load_sample_file(fsys, sys)
            <-
        if tracker_state.sample_btn_hover >= 0
            tracker_samples.handle_sample_field_btn(sys, tracker_state.sample_btn_hover)
            <-
        if tracker_state.sample_field_hover == 0
            tracker_state.editing_sample_name = true
            tracker_state.dirty = true
            <-
        if tracker_state.sample_action_hover == 0
            tracker_samples.cut_sample_to_selection(sys)
            <-
        if tracker_state.sample_action_hover == 1
            tracker_samples.set_loop_from_selection(sys)
            <-
        if tracker_state.sample_action_hover == 2
            tracker_samples.clear_sample_selection()
            <-
        if tracker_samples.begin_sample_drag(dev)
            <-
        tracker_state.editing_sample_name = false
        <-
    if tracker_ui.in_grid_scrollbar(dev)
        tracker_state.cursor_step = tracker_ui.scrollbar_step_at(my)
        tracker_editor.clamp_cursor()
        tracker_state.scrollbar_dragging = true
        tracker_state.dirty = true
        <-
    if mx >= tracker_constants.GRID_X && mx < tracker_constants.GRID_X + tracker_constants.TRACKS * tracker_editor.cell_w() && my >= tracker_constants.GRID_Y && my < tracker_constants.GRID_Y + tracker_constants.VISIBLE_STEPS * tracker_editor.row_h()
        let ?p_start = tracker_editor.page_start()
        let ?p_end = tracker_editor.page_end()
        let ?first_step = p_start
        if tracker_state.playing
            tracker_state.page = stdr.floor(tracker_state.play_step / tracker_editor.page_steps())
            p_start = tracker_editor.page_start()
            p_end = tracker_editor.page_end()
            first_step = tracker_state.play_step - 8
        else
            first_step = tracker_state.cursor_step - 8
        if first_step < p_start
            first_step = p_start
        if first_step > p_end - tracker_constants.VISIBLE_STEPS
            first_step = p_end - tracker_constants.VISIBLE_STEPS
        tracker_state.cursor_track = stdr.floor((mx - tracker_constants.GRID_X) / tracker_editor.cell_w())
        tracker_state.cursor_step = first_step + stdr.floor((my - tracker_constants.GRID_Y) / tracker_editor.row_h())
        tracker_editor.clamp_cursor()
        tracker_playback.trigger_step(sys, tracker_state.cursor_step)
        tracker_state.dirty = true
;

-> ()
    let sys = vimana.system()
    let scr = vimana.screen("Tracker", tracker_constants.SCREEN_W, tracker_constants.SCREEN_H, tracker_constants.SCALE)
    scr.set_cursor(tracker_constants.CURSOR_CHR)
    scr.hide_cursor()
    let dev = sys.device()
    let fsys = sys.file()
    tracker_font.install(scr)
    scr.set_sprite(tracker_constants.CURSOR_ADDR, tracker_constants.CURSOR_CHR, 1)
    scr.set_sprite(tracker_constants.BG_ADDR, tracker_constants.BG_CHR, 1)
    scr.set_sprite(tracker_constants.CLOSE_ADDR, tracker_constants.CLOSE_ICN, 1)
    scr.set_sprite(tracker_constants.CLOSE_DOWN_ADDR, tracker_constants.CLOSE_DOWN_ICN, 1)
    scr.set_drag_region(16)
    tracker_state.titlebar_saved_height = scr.height()
    tracker_state.bpm = tracker_demo.seed(tracker_state.notes, tracker_state.vols, tracker_state.waves)
    tracker_editor.ensure_editor_arrays()
    tracker_playback.song_alloc()
    tracker_playback.setup_audio(sys)
    let args = stdr.args()
    for (let ?i = 0; i < len(args); i += 1)
        let path = str(args[i] ?? "")
        if tracker_io.load_mod_path(fsys, sys, path)
            i = len(args)

    sys.run(scr, () => {
        dev.poll()
        let mx = dev.pointer_x()
        let my = dev.pointer_y()

        let titlebar_busy = tracker_ui.update_titlebar(dev, sys, scr)
        if !tracker_state.titlebar_shaded
            if !titlebar_busy
                handle_mouse(sys, dev, fsys)
            handle_keys(sys, dev, fsys)

        if tracker_state.playing && !tracker_state.titlebar_shaded
            if tracker_state.song_loaded
                let now = sys.ticks()
                let ?tick_ms = tracker_playback.tempo_tick_ms()
                if tick_ms < 1
                    tick_ms = 1
                if now - tracker_state.last_tick >= tick_ms
                    tracker_state.last_tick += tick_ms
                    if now - tracker_state.last_tick >= tick_ms * 4
                        tracker_state.last_tick = now
                    sys.begin_audio()
                    if tracker_state.play_tick == 0
                        tracker_playback.song_process_row(sys)
                    else
                        tracker_playback.song_apply_continuous(sys)
                    sys.end_audio()
                    tracker_state.play_tick += 1
                    if tracker_state.play_tick >= tracker_state.play_speed
                        tracker_state.play_tick = 0
                        tracker_playback.song_advance_row()
                    tracker_state.play_step = (tracker_state.play_order * 64 + tracker_state.play_row) % tracker_editor.total_steps()
                tracker_state.dirty = true
            else
                let now = sys.ticks()
                let step_ms = tracker_playback.editor_step_ms()
                if now - tracker_state.last_tick >= step_ms
                    tracker_state.last_tick = now
                    tracker_state.play_step = (tracker_state.play_step + 1) % tracker_editor.total_steps()
                    tracker_playback.trigger_step(sys, tracker_state.play_step)
                    tracker_state.dirty = true

        let cursor_dirty = mx != tracker_state.last_mx || my != tracker_state.last_my
        let full_redraw = tracker_state.dirty || cursor_dirty || tracker_state.close_button_active != tracker_state.last_close_button_state || tracker_state.titlebar_shaded != tracker_state.last_titlebar_shaded

        if full_redraw
            tracker_state.last_close_button_state = tracker_state.close_button_active
            tracker_state.last_titlebar_shaded = tracker_state.titlebar_shaded
            if !tracker_state.titlebar_shaded
                tracker_ui.draw(scr)
            else
                scr.clear(0)
            scr.set_auto(0x15).set_x(0).set_y(0)
            for (let ?i = 0; i < scr.width() / 8; i += 1)
                scr.set_addr(tracker_constants.BG_ADDR).sprite(0x85)
            tracker_ui.draw_titlebar_decor(scr)
            tracker_ui.draw_titlebar_text(scr, "Tracker")
            tracker_ui.draw_close_button(scr)
            scr.set_auto(0x00)
            tracker_state.dirty = false

        if full_redraw || cursor_dirty
            tracker_state.last_mx = mx
            tracker_state.last_my = my
            scr.set_auto(0x16).set_addr(tracker_constants.CURSOR_ADDR).set_x(mx).set_y(my).sprite(0x85)
            scr.set_auto(0x16).set_addr(tracker_constants.CURSOR_ADDR + 0x20).set_x(mx).set_y(my+8).sprite(0x85)
            scr.set_auto(0x00)

        scr.present()
    })
    tracker_playback.stop_all(sys)
;
