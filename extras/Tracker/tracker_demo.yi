cask tracker_demo

bring stdr
bring vimana

def PAGE_COUNT = 4
def PAGE_STEPS = 255
def STEPS = PAGE_COUNT * PAGE_STEPS
def TRACKS = 4
def BPM = 72
def NOTE_HOLD = -1
def NOTE_REST = -2

def MELODY_STEPS = [
    0, 18, 21, 24, 27, 30, 33, 36, 42, 45, 48, 66, 69, 72, 75, 78, 81, 84, 111, 114, 117, 120, 123, 126,
    129, 132, 159, 162, 165, 168, 171, 174, 177, 180, 183, 186, 198, 201, 204, 210, 216, 228, 288, 309, 312, 315, 318, 321,
    324, 327, 330, 339, 342, 345, 348, 351, 354, 357, 366, 369, 372, 378, 384, 387, 390, 393, 396, 402, 405, 408, 414, 420,
    423, 426, 429, 432, 438, 441, 444, 462, 465, 468, 474, 480, 483, 486, 489, 492, 498, 501, 504, 522, 525, 528, 534, 537,
    540, 567, 570, 573, 576, 582, 584, 586, 588, 594, 596, 598, 600, 606, 612, 618, 620, 622, 624, 630, 632, 634, 636, 638,
    640, 642, 644, 646, 648, 666, 669, 672, 675, 678, 681, 684, 690, 693, 696, 714, 717, 720, 723, 726, 729, 732, 759, 762,
    765, 768, 771, 774, 777, 780, 807, 810, 813, 816, 819, 822, 825, 828, 831, 834, 846, 849, 852, 858, 864, 876, 936, 957,
    960, 963, 966, 969, 972, 975, 978, 987, 990, 993, 996, 999, 1002, 1005, 1014, 1017
]

def MELODY_ENDS = [
    18, 21, 24, 27, 30, 33, 36, 42, 45, 48, 66, 69, 72, 75, 78, 81, 84, 111, 114, 117, 120, 123, 126, 129,
    132, 159, 162, 165, 168, 171, 174, 177, 180, 183, 186, 198, 201, 204, 210, 216, 228, 282, 309, 312, 315, 318, 321, 324,
    327, 330, 339, 342, 345, 348, 351, 354, 357, 366, 369, 372, 375, 381, 387, 390, 393, 396, 402, 405, 408, 411, 417, 423,
    426, 429, 432, 438, 441, 444, 462, 465, 468, 471, 477, 483, 486, 489, 492, 498, 501, 504, 522, 525, 528, 534, 537, 540,
    567, 570, 573, 576, 582, 584, 586, 588, 591, 596, 598, 600, 603, 609, 615, 620, 622, 624, 627, 632, 634, 636, 638, 640,
    642, 644, 646, 648, 666, 669, 672, 675, 678, 681, 684, 690, 693, 696, 714, 717, 720, 723, 726, 729, 732, 759, 762, 765,
    768, 771, 774, 777, 780, 807, 810, 813, 816, 819, 822, 825, 828, 831, 834, 846, 849, 852, 858, 864, 876, 930, 957, 960,
    963, 966, 969, 972, 975, 978, 987, 990, 993, 996, 999, 1002, 1005, 1014, 1017, 1020
]

def MELODY_NOTES = [
    72, 71, 72, 74, 72, 71, 69, 72, 72, 69, 72, 71, 72, 69, 67, 64, 65, 67, 65, 64, 62, 64, 65, 67,
    69, 67, 69, 71, 69, 67, 65, 64, 62, 64, 62, 60, 60, 62, 64, 65, 62, 67, 74, 72, 71, 69, 71, 72,
    74, 72, 71, 72, 71, 69, 72, 71, 69, 65, 65, 65, 65, 69, 72, 69, 71, 67, 65, 65, 65, 65, 69, 71,
    67, 69, 65, 62, 62, 60, 62, 62, 62, 62, 65, 69, 65, 67, 64, 62, 62, 60, 62, 62, 60, 62, 64, 65,
    67, 65, 64, 62, 60, 67, 67, 67, 67, 67, 67, 67, 67, 67, 67, 67, 67, 67, 67, 67, 67, 67, 67, 67,
    67, 67, 67, 67, 72, 71, 72, 74, 72, 71, 69, 72, 72, 69, 72, 71, 72, 69, 67, 64, 65, 67, 65, 64,
    62, 64, 65, 67, 69, 67, 69, 71, 69, 67, 65, 64, 62, 64, 62, 60, 60, 62, 64, 65, 62, 67, 74, 72,
    71, 69, 71, 72, 74, 72, 71, 72, 71, 69, 72, 71, 69, 65, 65, 65
]

: idx(step = num, track = num) (( num ))
    <- step * TRACKS + track
;

: put_note(notes = any, vols = any, step = num, track = num, note = num, vol = num) (( -- ))
    if step < 0 || step >= STEPS || track < 0 || track >= TRACKS
        <-
    notes[idx(step, track)] = note
    vols[idx(step, track)] = vol
;

: put_rest(notes = any, vols = any, step = num, track = num) (( -- ))
    if step < 0 || step >= STEPS || track < 0 || track >= TRACKS
        <-
    notes[idx(step, track)] = NOTE_REST
    vols[idx(step, track)] = 0
;

: seed_melody(notes = any, vols = any) (( -- ))
    for (let ?i = 0; i < stdr.len(MELODY_STEPS); i += 1)
        put_note(notes, vols, MELODY_STEPS[i], 0, MELODY_NOTES[i], 12)
        if MELODY_ENDS[i] < STEPS
            put_rest(notes, vols, MELODY_ENDS[i], 0)
;

: seed_pedal(notes = any, vols = any) (( -- ))
    for (let ?s = 0; s < STEPS; s += 36)
        put_note(notes, vols, s, 1, 36, 8)
        put_note(notes, vols, s + 18, 2, 43, 7)
;

: seed_snare(notes = any, vols = any) (( -- ))
    for (let ?base = 0; base < STEPS; base += 72)
        put_note(notes, vols, base + 0, 3, 31, 8)
        put_rest(notes, vols, base + 3, 3)
        put_note(notes, vols, base + 6, 3, 31, 5)
        put_rest(notes, vols, base + 8, 3)
        put_note(notes, vols, base + 8, 3, 31, 5)
        put_rest(notes, vols, base + 10, 3)
        put_note(notes, vols, base + 10, 3, 31, 5)
        put_rest(notes, vols, base + 12, 3)
        put_note(notes, vols, base + 12, 3, 31, 8)
        put_rest(notes, vols, base + 15, 3)
        put_note(notes, vols, base + 18, 3, 31, 5)
        put_rest(notes, vols, base + 20, 3)
        put_note(notes, vols, base + 20, 3, 31, 5)
        put_rest(notes, vols, base + 22, 3)
        put_note(notes, vols, base + 22, 3, 31, 5)
        put_rest(notes, vols, base + 24, 3)
        put_note(notes, vols, base + 24, 3, 31, 8)
        put_rest(notes, vols, base + 27, 3)
        put_note(notes, vols, base + 30, 3, 31, 8)
        put_rest(notes, vols, base + 33, 3)
        put_note(notes, vols, base + 36, 3, 31, 8)
        put_rest(notes, vols, base + 39, 3)
        put_note(notes, vols, base + 42, 3, 31, 5)
        put_rest(notes, vols, base + 44, 3)
        put_note(notes, vols, base + 44, 3, 31, 5)
        put_rest(notes, vols, base + 46, 3)
        put_note(notes, vols, base + 46, 3, 31, 5)
        put_rest(notes, vols, base + 48, 3)
        put_note(notes, vols, base + 48, 3, 31, 8)
        put_rest(notes, vols, base + 51, 3)
        put_note(notes, vols, base + 54, 3, 31, 5)
        put_rest(notes, vols, base + 56, 3)
        put_note(notes, vols, base + 56, 3, 31, 5)
        put_rest(notes, vols, base + 58, 3)
        put_note(notes, vols, base + 58, 3, 31, 5)
        put_rest(notes, vols, base + 60, 3)
        put_note(notes, vols, base + 60, 3, 31, 5)
        put_rest(notes, vols, base + 62, 3)
        put_note(notes, vols, base + 62, 3, 31, 5)
        put_rest(notes, vols, base + 64, 3)
        put_note(notes, vols, base + 64, 3, 31, 5)
        put_rest(notes, vols, base + 66, 3)
        put_note(notes, vols, base + 66, 3, 31, 5)
        put_rest(notes, vols, base + 68, 3)
        put_note(notes, vols, base + 68, 3, 31, 5)
        put_rest(notes, vols, base + 70, 3)
        put_note(notes, vols, base + 70, 3, 31, 5)
        put_rest(notes, vols, base + 72, 3)
;

:: seed(notes = any, vols = any, waves = any) (( num ))
    for (let ?i = 0; i < STEPS * TRACKS; i += 1)
        stdr.push(notes, NOTE_HOLD)
        stdr.push(vols, 0)
    for (let ?t = 0; t < TRACKS; t += 1)
        stdr.push(waves, vimana.wave_pulse)
    waves[0] = vimana.wave_triangle
    waves[1] = vimana.wave_sawtooth
    waves[2] = vimana.wave_pulse
    waves[3] = vimana.wave_noise
    seed_melody(notes, vols)
    seed_pedal(notes, vols)
    seed_snare(notes, vols)
    <- BPM
;
