cask chess_data

bring chess_model

-- Chess pieces, 16×16 1bpp. Each glyph is 16 rows; each row is a 16-bit
-- word with bit 15 = leftmost pixel.
--
-- Two passes:
--   1) Outline pass: for every OFF pixel adjacent to an ON pixel, draw
--      the outline colour. This gives a 1-pixel border of contrasting
--      colour so white pieces stay visible on light squares and black
--      pieces stay visible on dark squares.
--   2) Body pass: stamp ON pixels in the body colour.
--
-- See chess_view.draw_piece16 for the renderer.

def PAWN_BMP = [
    0x0000,
    0x0180,  -- .......##.......
    0x03C0,  -- ......####......
    0x07E0,  -- .....######.....
    0x07E0,
    0x03C0,
    0x07E0,
    0x0FF0,  -- ....########....
    0x0660,  -- .....##..##.....
    0x0FF0,
    0x1FF8,  -- ...##########...
    0x3FFC,  -- ..############..
    0x7FFE,  -- .##############.
    0x7FFE,
    0xFFFF,  -- ################
    0x0000
]

def KNIGHT_BMP = [
    0x0000,
    0x0780,  -- .....####.......
    0x0FC0,  -- ....######......
    0x1FE0,  -- ...########.....
    0x3FF0,  -- ..##########....
    0x7CF8,  -- .#####..#####...
    0x3CFC,  -- ..####..######..
    0x1CFE,  -- ...###..#######.
    0x0CFE,
    0x0CFE,
    0x07FE,  -- .....##########.
    0x07FE,
    0x0FFE,  -- ....###########.
    0x1FFE,
    0x3FFF,
    0x0000
]

def BISHOP_BMP = [
    0x0000,
    0x0180,  -- .......##.......
    0x03C0,
    0x07E0,
    0x07E0,
    0x0FF0,
    0x07E0,
    0x0FF0,
    0x1FF8,
    0x3CFC,  -- ..####..######..
    0x3FFC,
    0x3FFC,
    0x1FF8,
    0x0FF0,
    0x7FFE,
    0xFFFF
]

def ROOK_BMP = [
    0x0000,
    0xDB6E,  -- ##.##.##.##.###.   crenellations
    0xDB6E,
    0xFFFE,
    0x7FFC,  -- .#############..
    0x3FF8,
    0x3FF8,
    0x3FF8,
    0x3FF8,
    0x3FF8,
    0x3FF8,
    0x3FF8,
    0x3FF8,
    0x7FFC,
    0xFFFE,
    0xFFFF
]

def QUEEN_BMP = [
    0x0000,
    0x8181,  -- #......##......#   crown points
    0xC3C3,
    0xE7E7,
    0xFFFF,
    0x7FFE,
    0x3FFC,
    0x3FFC,
    0x1FF8,
    0x1FF8,
    0x3FFC,
    0x3FFC,
    0x3FFC,
    0x7FFE,
    0xFFFF,
    0xFFFF
]

def KING_BMP = [
    0x0180,  -- .......##.......   cross
    0x0180,
    0x0FF0,  -- ....########....
    0x0FF0,
    0x0180,
    0x07E0,
    0x0FF0,
    0x1FF8,
    0x3FFC,
    0x3FFC,
    0x3FFC,
    0x1FF8,
    0x1FF8,
    0x3FFC,
    0x7FFE,
    0xFFFF
]

:: piece_bitmap(kind = num) (( [num] ))
    if kind == chess_model.PAWN
        <- PAWN_BMP
    if kind == chess_model.KNIGHT
        <- KNIGHT_BMP
    if kind == chess_model.BISHOP
        <- BISHOP_BMP
    if kind == chess_model.ROOK
        <- ROOK_BMP
    if kind == chess_model.QUEEN
        <- QUEEN_BMP
    if kind == chess_model.KING
        <- KING_BMP
    <- PAWN_BMP
;
