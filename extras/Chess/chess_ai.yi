cask chess_ai

bring stdr
bring chess_model

-- Negamax search with material evaluation.
--   - The model's gen_moves returns legal moves only (no leaving the king in
--     check) and includes castling + en-passant, so the AI inherits those
--     rules for free.
--   - "No legal moves" inside negamax means checkmate (if currently in check
--     → very negative score) or stalemate (→ 0, a draw).
--   - Search uses snapshot/restore around search_move so castling rights,
--     en-passant targets, and the side to move all round-trip correctly.

def VALUE_PAWN   = 100
def VALUE_KNIGHT = 320
def VALUE_BISHOP = 330
def VALUE_ROOK   = 500
def VALUE_QUEEN  = 900
def VALUE_KING   = 20000
def NEG_INF      = -999999
def MATE_SCORE   = 100000

pub def DEFAULT_DEPTH = 2

: piece_value(kind = num) (( num ))
    if kind == chess_model.PAWN
        <- VALUE_PAWN
    if kind == chess_model.KNIGHT
        <- VALUE_KNIGHT
    if kind == chess_model.BISHOP
        <- VALUE_BISHOP
    if kind == chess_model.ROOK
        <- VALUE_ROOK
    if kind == chess_model.QUEEN
        <- VALUE_QUEEN
    if kind == chess_model.KING
        <- VALUE_KING
    <- 0
;

-- Static material evaluation from `side`'s POV.
: evaluate(side = num) (( num ))
    let ?score = 0
    for (let ?y = 0; y < 8; y += 1)
        for (let ?x = 0; x < 8; x += 1)
            let p = chess_model.piece_at(x, y)
            if p == 0
                continue
            let v = piece_value(chess_model.piece_type(p))
            if chess_model.piece_side(p) == side
                score += v
            else
                score -= v
    <- score
;

: other(side = num) (( num ))
    <- 1 - side
;

-- Negamax. Returns best score for `side` to move with `depth` plies remaining.
: negamax(side = num, depth = num) (( num ))
    if depth == 0
        <- evaluate(side)

    let ?best = NEG_INF
    let ?has_move = false

    for (let ?y = 0; y < 8; y += 1)
        for (let ?x = 0; x < 8; x += 1)
            let p = chess_model.piece_at(x, y)
            if p == 0
                continue
            if chess_model.piece_side(p) != side
                continue
            let moves = chess_model.gen_moves(x, y)
            let count = stdr.floor(#moves / 2)
            for (let ?i = 0; i < count; i += 1)
                let tx = moves[i * 2]
                let ty = moves[i * 2 + 1]
                let snap = chess_model.snapshot()
                chess_model.search_move(x, y, tx, ty)
                let score = -negamax(other(side), depth - 1)
                chess_model.restore(snap)
                has_move = true
                if score > best
                    best = score

    if !has_move
        -- No legal moves: checkmate or stalemate.
        if chess_model.in_check(side)
            <- -MATE_SCORE
        <- 0
    <- best
;

-- Returns [fx, fy, tx, ty] for the best move, or [-1, -1, -1, -1] if none.
:: choose_move(side = num, depth = num) (( [num] ))
    let ?best_score = NEG_INF
    let ?best = [-1, -1, -1, -1]
    let ?picked = 0
    for (let ?y = 0; y < 8; y += 1)
        for (let ?x = 0; x < 8; x += 1)
            let p = chess_model.piece_at(x, y)
            if p == 0
                continue
            if chess_model.piece_side(p) != side
                continue
            let moves = chess_model.gen_moves(x, y)
            let count = stdr.floor(#moves / 2)
            for (let ?i = 0; i < count; i += 1)
                let tx = moves[i * 2]
                let ty = moves[i * 2 + 1]
                let snap = chess_model.snapshot()
                chess_model.search_move(x, y, tx, ty)
                let score = -negamax(other(side), depth - 1)
                chess_model.restore(snap)
                if score > best_score
                    best_score = score
                    best = [x, y, tx, ty]
                    picked = 1
                elif score == best_score && picked > 0
                    picked += 1
                    if (y * 8 + x + tx + ty) % picked == 0
                        best = [x, y, tx, ty]
    <- best
;
