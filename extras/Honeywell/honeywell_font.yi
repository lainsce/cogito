cask honeywell_font

bring vimana

def BLANK = [0x0000, 0x0000, 0x0000, 0x0000]
def QUESTION = [0xe010, 0x2060, 0x0040, 0x0000]

: glyph(code = num) (( [any] ))
    if code == 32 <- BLANK -- SPACE
    if code == 33 <- [0x6060, 0x6060, 0x0060, 0x0000] -- !
    if code == 35 <- [0xa0f0, 0xa0f0, 0xa000, 0x0000] -- #
    if code == 43 <- [0x0020, 0x20f8, 0x2020, 0x0000] -- +
    if code == 44 <- [0x0000, 0x6060, 0x2040, 0x0000] -- ,
    if code == 48 <- [0x6090, 0x9090, 0x9060, 0x0000] -- 0
    if code == 49 <- [0x0020, 0x6020, 0x2070, 0x0000] -- 1
    if code == 50 <- [0x0060, 0x1020, 0x4070, 0x0000] -- 2
    if code == 51 <- [0xf010, 0x6020, 0x9060, 0x0000] -- 3
    if code == 52 <- [0x00a0, 0xf020, 0x2020, 0x0000] -- 4
    if code == 53 <- [0xf080, 0xe010, 0x9060, 0x0000] -- 5
    if code == 54 <- [0x6080, 0xe090, 0x9060, 0x0000] -- 6
    if code == 55 <- [0xf010, 0x2020, 0x4040, 0x0000] -- 7
    if code == 56 <- [0x6090, 0x6090, 0x9060, 0x0000] -- 8
    if code == 57 <- [0x6090, 0x9070, 0x1060, 0x0000] -- 9
    if code == 59 <- [0x6000, 0x6060, 0x2040, 0x0000] -- ;
    if code == 62 <- [0x8040, 0x2010, 0x2040, 0x8000] -- >
    if code == 65 <- [0x6090, 0x90f0, 0x9090, 0x0000] -- A
    if code == 66 <- [0xe090, 0xe090, 0x90e0, 0x0000] -- B
    if code == 67 <- [0x7080, 0x8080, 0x8070, 0x0000] -- C
    if code == 68 <- [0xe090, 0x9090, 0x90e0, 0x0000] -- D
    if code == 69 <- [0xf080, 0xe080, 0x80f0, 0x0000] -- E
    if code == 70 <- [0xf080, 0xe080, 0x8080, 0x0000] -- F
    if code == 71 <- [0x7080, 0x80b0, 0x9070, 0x0000] -- G
    if code == 72 <- [0x9090, 0xf090, 0x9090, 0x0000] -- H
    if code == 73 <- [0xe040, 0x4040, 0x40e0, 0x0000] -- I
    if code == 74 <- [0x3010, 0x1010, 0x9060, 0x0000] -- J
    if code == 75 <- [0x90a0, 0xc0a0, 0x9090, 0x0000] -- K
    if code == 76 <- [0x8080, 0x8080, 0x80f0, 0x0000] -- L
    if code == 77 <- [0x90f0, 0xf090, 0x9090, 0x0000] -- M
    if code == 78 <- [0x90d0, 0xb090, 0x9090, 0x0000] -- N
    if code == 79 <- [0x6090, 0x9090, 0x9060, 0x0000] -- O
    if code == 80 <- [0xe090, 0x90e0, 0x8080, 0x0000] -- P
    if code == 81 <- [0x6090, 0x9090, 0xa050, 0x0000] -- Q
    if code == 82 <- [0xe090, 0x90e0, 0xa090, 0x0000] -- R
    if code == 83 <- [0x7080, 0x6000, 0x10e0, 0x0000] -- S
    if code == 84 <- [0xe040, 0x4040, 0x4040, 0x0000] -- T
    if code == 85 <- [0x9090, 0x9090, 0x9060, 0x0000] -- U
    if code == 86 <- [0x9090, 0x9090, 0x6040, 0x0000] -- V
    if code == 87 <- [0x9090, 0x90f0, 0xf090, 0x0000] -- W
    if code == 88 <- [0x9090, 0x6040, 0x6090, 0x0000] -- X
    if code == 89 <- [0x9090, 0x6040, 0x4040, 0x0000] -- Y
    if code == 90 <- [0xf010, 0x2040, 0x80f0, 0x0000] -- Z
    if code == 91 <- [0xe080, 0x8080, 0x80e0, 0x0000] -- [
    if code == 93 <- [0xe020, 0x2020, 0x20e0, 0x0000] -- ]
    if code == 94 <- [0x40a0, 0x0000, 0x0000, 0x0000] -- ^
    <- QUESTION
;

:: install(scr = vimana.screen) (( vimana.screen ))
    for (let ?code = 0; code < 128; code += 1)
        scr.set_font(code, glyph(code))
        scr.set_font_width(code, 5)
    <- scr
;
